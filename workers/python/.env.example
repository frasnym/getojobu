# GetOJobu Python Temporal Worker environment variables
# Copy to .env for local development (do not commit real values).

# Temporal (reuses existing Hermes Temporal via a dedicated getojobu namespace)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=getojobu
TEMPORAL_TASK_QUEUE_JOB_ANALYZE=job-evaluation

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/getojobu

# LLM (OpenAI by default; provider can be "openai" or "anthropic")
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key
