# Server
API_SERVER_ADDR=your-api_server_addr
API_SERVER_READ_TIMEOUT=your-api_server_read_timeout
API_SERVER_WRITE_TIMEOUT=your-api_server_write_timeout
API_SERVER_SHUTDOWN_TIMEOUT=your-api_server_shutdown_timeout

SWAGGER_TOKEN=your-swagger_token

# Swagger UI HTTP Basic Auth token (production only). When set, opening
# /swagger/ triggers a browser username/password popup; any username works,
# password must equal SWAGGER_TOKEN. When unset (local dev), Swagger is open
# without auth.

# LOG_LEVEL=your-# log_level
LOG_LEVEL=your-log_level

# Database (preferred)
DATABASE_URL=your-database_url

# Database (individual PG* vars, used when DATABASE_URL is unset)
PG_HOST=your-pg_host
PG_PORT=your-pg_port
PG_DATABASE=your-pg_database
PG_USER=your-pg_user
PG_PASSWORD=your-pg_password
PG_SSL_MODE=your-pg_ssl_mode
PG_CHANNEL_BINDING=your-pg_channel_binding

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-next_public_clerk_publishable_key
CLERK_SECRET_KEY=your-clerk_secret_key
CLERK_AUTHORIZED_PARTIES=your-clerk_authorized_parties
CLERK_WEBHOOK_SECRET=your-clerk_webhook_secret

# Machine API keys (server-side auth, mapped to internal principals)
CRON_API_KEY=your-cron_api_key
HERMES_API_KEY=your-hermes_api_key
PLAYWRIGHT_API_KEY=your-playwright_api_key
WORKER_API_KEY=your-worker_api_key

# Temporal orchestrator
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_JOB_ANALYZE=job-evaluation

# Cloudflare R2 object storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=getojobu
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
