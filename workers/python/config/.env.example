# Getojobu Python Temporal worker configuration
# Copy to .env and fill in values before running.

# Temporal (existing Hermes server, dedicated getojobu namespace)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=getojobu
TEMPORAL_TASK_QUEUE_JOB_ANALYZE=job-evaluation
TEMPORAL_TASK_QUEUE_JOB_SCRAPE=job-scrape
TEMPORAL_TASK_QUEUE_JOB_LIMIT=job-limit

# Go API (internal Docker network: http://getojobu-api:8080, or local dev: http://localhost:8080)
API_BASE_URL=http://getojobu-api:8080
API_KEY=change-me-internal-worker-key # Must match WORKER_API_KEY in apps/backend

# OmniRoute router (OpenAI-compatible, internal Docker network)
OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=change-me-omniroute-key
OMNIROUTE_MODEL=use-combo

# Cloudflare R2 object storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=getojobu
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

