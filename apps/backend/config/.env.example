# Server
API_SERVER_ADDR=your-api_server_addr
API_SERVER_READ_TIMEOUT=your-api_server_read_timeout
API_SERVER_WRITE_TIMEOUT=your-api_server_write_timeout
API_SERVER_SHUTDOWN_TIMEOUT=your-api_server_shutdown_timeout

# LOG_LEVEL=your-# log_level
LOG_LEVEL=your-log_level

# Database (preferred)
DATABASE_URL=your-database_url

# Database (individual PG* vars, used when DATABASE_URL is unset)
PG_HOST=your-pg_host
PG_PORT=your-pg_port
PG_DATABASE=your-pg_database
PG_USER=your-pg_user
PG_PASSWORD=your-pg_password
PG_SSL_MODE=your-pg_ssl_mode
PG_CHANNEL_BINDING=your-pg_channel_binding

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-next_public_clerk_publishable_key
CLERK_SECRET_KEY=your-clerk_secret_key
CLERK_AUTHORIZED_PARTIES=your-clerk_authorized_parties
CLERK_WEBHOOK_SECRET=your-clerk_webhook_secret