# Server
API_SERVER_ADDR=:8080
API_SERVER_READ_TIMEOUT=5s
API_SERVER_WRITE_TIMEOUT=10s
API_SERVER_SHUTDOWN_TIMEOUT=15s

# Database (preferred)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Database (individual PG* vars, used when DATABASE_URL is unset)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=getojobu
PG_USER=getojobu
PG_PASSWORD=getojobu
PG_SSL_MODE=require
PG_CHANNEL_BINDING=prefer
